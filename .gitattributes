# Text files: normalise line endings
* text=auto eol=lf
*.cs text diff=csharp
*.sln text eol=crlf

# Unity YAML assets are text
*.unity text
*.prefab text
*.asset text
*.mat text
*.anim text
*.controller text
*.meta text
*.physicMaterial text
*.overrideController text
*.mask text
*.playable text
*.shadergraph text
*.shadersubgraph text

# Large binary assets go to Git LFS
# 3D models and animation sources
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.bvh filter=lfs diff=lfs merge=lfs -text
*.c3d filter=lfs diff=lfs merge=lfs -text
