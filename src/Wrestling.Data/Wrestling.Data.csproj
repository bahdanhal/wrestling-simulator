<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity 6 compiles C# 9 against .NET Standard 2.1. -->
    <LangVersion>9.0</LangVersion>
    <DebugType>portable</DebugType>
    <RootNamespace>Wrestling.Data</RootNamespace>
    <CopyToUnity>true</CopyToUnity>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wrestling.Core\Wrestling.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>

  <!-- C# 9 init-only setters on .NET Standard 2.1. -->
  <ItemGroup>
    <Compile Include="..\Shared\IsExternalInit.cs" Link="Shared\IsExternalInit.cs" />
  </ItemGroup>

</Project>
